NODE_ENV=development
PORT=3000
LOG_LEVEL=INFO
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_DATABASE=postgres
MIGRATION_DB_DATABASE=
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=
AUTH_JWT_ACTIVE_KID=local-dev
AUTH_JWT_PRIVATE_KEY_BASE64=CHANGE_ME_BASE64_PRIVATE_KEY
AUTH_JWT_PUBLIC_KEYS_JSON={"local-dev":"CHANGE_ME_BASE64_PUBLIC_KEY"}
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_PEPPER=CHANGE_ME_WITH_AT_LEAST_32_CHARACTERS
APP_CORS_ORIGIN=http://localhost:4200
AUTH_ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
AUTH_REFRESH_TOKEN_EXPIRES_IN_DAYS=30
DB_SYNC=false