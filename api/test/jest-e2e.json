{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "<rootDir>/tsconfig.e2e.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "setupFiles": [
    "<rootDir>/test/setup-e2e.ts"
  ],
  "testEnvironment": "node",
  "testTimeout": 30000,
  "detectOpenHandles": true,
  "clearMocks": true
}